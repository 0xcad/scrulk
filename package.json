{
  "name": "scrulk",
  "version": "0.1.0",
  "private": true,
  "description": "Scroll Unlock — a friction-adding browser extension for tracked websites",
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm test && npm run build && npm run build:firefox-debug",
    "dev": "vite",
    "dev:firefox": "BROWSER=firefox vite",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && BROWSER=firefox vite build",
    "build:firefox-debug": "tsc --noEmit && BROWSER=firefox SCRULK_DEBUG=1 vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.1",
    "idb": "^8.0.3",
    "mdast-util-from-markdown": "^2.0.3",
    "moveable": "^0.53.0",
    "preact": "^10.22.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^25.6.2",
    "@types/webextension-polyfill": "^0.12.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
